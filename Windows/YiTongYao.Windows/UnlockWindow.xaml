<Window x:Class="YiTongYao.Windows.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="易通遥 需要验证" Height="300" Width="560"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource AppFg}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="Assets\vty_icon.ico">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="10" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="验证方式" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppFgMuted}" Margin="0,0,0,8"/>
                <ListBox x:Name="MethodList" Background="Transparent" Foreground="{DynamicResource AppFg}"
                         BorderThickness="0" SelectionChanged="MethodList_SelectionChanged"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PromptText" Grid.Row="0" FontSize="13" Foreground="{DynamicResource AppFgMuted}"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>

            <StackPanel x:Name="ContentHost" Grid.Row="1" VerticalAlignment="Top"/>

            <TextBlock x:Name="HintText" Grid.Row="2" FontSize="12" Foreground="{DynamicResource AppDanger}"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0"/>

            <TextBlock x:Name="RecoverText" Grid.Row="3" FontSize="12" Foreground="{DynamicResource AppAccent}"
                       Cursor="Hand" Visibility="Collapsed" Margin="0,8,0,0">忘记密码？</TextBlock>
        </Grid>
    </Grid>
</Window>
