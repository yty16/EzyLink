<Window x:Class="YiTongYao.Windows.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫码连接" Height="520" Width="440"
        Background="#1b1136" Foreground="#ECEAFF"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="Assets\vty_icon.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="扫码连接" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1" Text="用手机 / 手表端的「扫码连接」扫描下方二维码，即可自动填入地址与配对码并连接。"
                   FontSize="12" Foreground="#9C93C9" TextWrapping="Wrap"
                   HorizontalAlignment="Center" Margin="0,10,0,0" TextAlignment="Center"/>

        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10" Padding="10"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="QrImage" Stretch="None" SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,12,0,0">
            <TextBlock x:Name="AddrText" FontSize="13" Foreground="#36E2E8"
                       HorizontalAlignment="Center" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button x:Name="CopyBtn" Content="复制地址" Background="#3a2a6e" Foreground="#ECEAFF"
                        Padding="14,6" Margin="0,0,10,0" FontSize="13"
                        BorderThickness="0" Cursor="Hand" Click="CopyBtn_Click"/>
                <Button x:Name="CloseBtn" Content="关闭" Background="#3a2a6e" Foreground="#ECEAFF"
                        Padding="14,6" BorderThickness="0" Cursor="Hand" Click="CloseBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
