<Window x:Class="YiTongYao.Windows.PrivacyConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="隐私告知与同意 · 易通遥 EzyLink" Height="760" Width="660"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource AppFg}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="Assets\vty_icon.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="隐私告知与同意" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>

        <TextBlock x:Name="SubtitleText" Grid.Row="1" FontSize="12" Foreground="{DynamicResource AppFgMuted}"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Border Grid.Row="2" Background="{DynamicResource AppLogBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <StackPanel>
                    <TextBlock Text="一、处理目的" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppFg}" Margin="0,0,0,3"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,10">
                        在你的设备与电脑之间建立局域网远程控制通道，用于 PPT 放映控制，
                        以及锁屏 / 睡眠 / 关机 / 重启 / 网络唤醒（WoL）等系统操作。
                    </TextBlock>

                    <TextBlock Text="二、处理方式" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppFg}" Margin="0,0,0,3"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,2">
                        · 控制指令以点对点 TCP 在你自己的局域网内传输，不经过本项目或任何第三方服务器；
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,2">
                        · 配对码、电脑 IP / 端口、安全认证密码等仅保存在本机，密码只存 PBKDF2 哈希、不存明文；
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,2">
                        · 扫码连接的相机画面只在内存中实时解码，不写文件、不传输、不留存；
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,10">
                        · 自动更新仅向 GitHub Releases 公开接口查询最新版本号，不含任何本机个人信息，下载需你确认。
                    </TextBlock>

                    <TextBlock Text="三、对个人权益的影响" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppFg}" Margin="0,0,0,3"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,2">
                        · 开启服务后，同一局域网内持有配对码的设备可控制你的电脑；
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,10">
                        · 关机 / 重启等操作具有破坏性，执行前请务必保存好正在编辑的文件与数据。
                        你可随时停止服务或重新生成配对码。
                    </TextBlock>

                    <TextBlock Text="四、保存期限" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppFg}" Margin="0,0,0,3"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,2">
                        · 设置数据：保存至你主动修改或删除，无自动过期；
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,2">
                        · 运行 / 崩溃日志：仅存于本机用于排错，可随时手动删除；
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,10">
                        · 扫码画面：内存中即用即弃，不留存。
                    </TextBlock>

                    <TextBlock Text="五、你的权利（查阅 / 更正 / 删除 / 撤回同意）" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppFg}" Margin="0,0,0,3"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,2">
                        · 查阅与更正：电脑端设置目录 %LOCALAPPDATA%\YiTongYao\，移动端 App 内设置页；
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,2">
                        · 删除：删除上述设置目录即清除电脑端全部本地数据；卸载移动端 App 即清除其私有数据；
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,10">
                        · 撤回同意：主界面「隐私与授权」区可撤回；撤回后服务停止，下次启动会重新征求你的同意。
                    </TextBlock>

                    <TextBlock Text="六、说明" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppFg}" Margin="0,0,0,3"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,2">
                        本告知构成《隐私政策》的核心内容，完整文本见项目内 PRIVACY.md。
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,2">
                        本软件不使用人脸识别，不采集任何生物特征信息。
                    </TextBlock>

                    <TextBlock Text="七、免责声明" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppFg}" Margin="0,4,0,3"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,2">
                        · 本软件按「现状」提供，不保证绝对无缺陷或无中断，使用风险由你自行承担；
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,2">
                        · 关机 / 重启等操作具有破坏性，执行前请务必保存文件与数据；因使用本软件导致的任何数据丢失、系统损坏或间接损失，开发者不承担责任；
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,10">
                        · 你须仅在自己拥有或已获授权的设备上使用，严禁未授权控制或违法用途；相关责任由使用者自行承担。完整文本见仓库 DISCLAIMER.md。
                    </TextBlock>

                    <TextBlock Text="八、用户协议" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppFg}" Margin="0,0,0,3"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,2">
                        · 使用本软件即表示同意本协议；仅可用于合法、已获授权的场景；
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,2">
                        · 本软件著作权归开发者所有，依仓库 LICENSE 分发；不收集任何个人信息，数据仅存本机与局域网；
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource AppFgMuted}" TextWrapping="Wrap" LineHeight="19" Margin="2,0,0,2">
                        · 开发者保留修改协议的权利，继续使用即视为接受。完整文本见仓库 TERMS.md。
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource AppLogBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <StackPanel>
                <CheckBox x:Name="PolicyCheck" Content="我已阅读并同意《隐私政策》"
                          Foreground="{DynamicResource AppFg}" FontSize="13" Margin="0,0,0,6"
                          Checked="PolicyCheck_Changed" Unchecked="PolicyCheck_Changed"/>
                <CheckBox x:Name="TermsCheck" Content="我已阅读并同意《免责声明》与《用户协议》"
                          Foreground="{DynamicResource AppFg}" FontSize="13"
                          Checked="TermsCheck_Changed" Unchecked="TermsCheck_Changed"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="HintText" Grid.Row="4" FontSize="11" Foreground="{DynamicResource AppFgDim}"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <Button x:Name="DeclineBtn" Content="关闭" Padding="16,7" Margin="0,0,10,0"
                    Background="{DynamicResource AppControlBg}" Foreground="{DynamicResource AppFg}" BorderThickness="0" Click="DeclineBtn_Click"/>
            <Button x:Name="AcceptBtn" Content="同意并继续" Padding="16,7" IsEnabled="False"
                    Background="{StaticResource BrandBrush}" Foreground="{DynamicResource AppAccentFg}" BorderThickness="0" Click="AcceptBtn_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,2,0,0">
            <TextBlock FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center">
                <Hyperlink x:Name="RepoLink" Click="RepoLink_Click">
                    项目仓库（含完整《隐私政策》PRIVACY.md）
                </Hyperlink>
            </TextBlock>
            <TextBlock FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,2,0,0">
                <Hyperlink x:Name="IssueLink" Click="IssueLink_Click">
                    遇到问题或建议，可在 GitHub 提交 Issue
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
