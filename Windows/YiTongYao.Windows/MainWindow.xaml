<Window x:Class="YiTongYao.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="易通遥 远程控制" Height="880" Width="880"
        Background="#1b1136" Foreground="#ECEAFF"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged" Closing="Window_Closing"
        Icon="Assets\vty_icon.ico">
    <Window.Resources>
        <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#36E2E8" Offset="0"/>
            <GradientStop Color="#965CE9" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#251846"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9C93C9"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECEAFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#ECEAFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,18,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
            <Setter Property="Foreground" Value="#11102A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- 深色卡片内的次级按钮。禁用态必须显式指定颜色：
             WPF 默认的禁用样式是「浅底 + 淡化字」，放在深色背景上会变成白底白字、完全看不见 -->
        <Style x:Key="CardBtn" TargetType="Button" BasedOn="{StaticResource AccentBtn}">
            <Setter Property="Background" Value="#3a2a6e"/>
            <Setter Property="Foreground" Value="#ECEAFF"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2a2350"/>
                    <Setter Property="Foreground" Value="#9A90C4"/>
                    <Setter Property="Cursor" Value="None"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 主操作按钮（启停服务）：禁用时保留渐变底色，仅降低不透明度表示不可用 -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource AccentBtn}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
                    <Setter Property="Foreground" Value="#11102A"/>
                    <Setter Property="Opacity" Value="0.6"/>
                    <Setter Property="Cursor" Value="None"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
            <Image Source="Assets\vty_icon.png" Width="42" Height="42" Margin="0,0,12,0"/>
            <TextBlock Text="易通遥 远程控制" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="#9C93C9" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button x:Name="CheckUpdateBtn" Content="检查更新" Style="{StaticResource AccentBtn}"
                    Background="#3a2a6e" Foreground="#ECEAFF" Margin="14,0,0,0" Click="CheckUpdateBtn_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#888" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="服务未启动" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="本机 IP：" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="IpText" Style="{StaticResource Value}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="端口：" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    <TextBox x:Name="PortBox" Width="80" Background="#1b1136" Foreground="#ECEAFF" BorderBrush="#3a2a6e" Margin="6,0,0,0" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="MAC（WoL）：" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MacText" Style="{StaticResource Value}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="主机名：" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HostText" Style="{StaticResource Value}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="设备连接地址：" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnectAddrText" Text="获取中…" FontSize="16" FontWeight="Bold"
                                   Foreground="#36E2E8" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <Button x:Name="QrBtn" Content="扫码连接" Style="{StaticResource AccentBtn}"
                                Background="#3a2a6e" Foreground="#ECEAFF" Margin="16,0,0,0" Click="QrBtn_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="HotspotText" Text="移动热点：检测中…" FontSize="12" Foreground="#9C93C9"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="HotspotBtn" Content="开启移动热点设置" Style="{StaticResource AccentBtn}"
                                Background="#3a2a6e" Foreground="#ECEAFF" Click="HotspotBtn_Click"/>
                        <Button x:Name="FirewallBtn" Content="防火墙放行" Style="{StaticResource AccentBtn}"
                                Background="#3a2a6e" Foreground="#ECEAFF" Margin="10,0,0,0" Click="FirewallBtn_Click"/>
                        <Button x:Name="RefreshBtn" Content="刷新" Style="{StaticResource AccentBtn}"
                                Background="#3a2a6e" Foreground="#ECEAFF" Margin="10,0,0,0" Click="RefreshBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="配对码：" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TokenText" Text="------" FontSize="22" FontWeight="Bold" Foreground="#36E2E8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button x:Name="RegenBtn" Content="重新生成" Style="{StaticResource AccentBtn}" Margin="14,0,0,0" Background="#3a2a6e" Foreground="#ECEAFF" Click="RegenBtn_Click"/>
                </StackPanel>
                <Button x:Name="ToggleBtn" Grid.Column="1" Content="启动服务" Style="{StaticResource PrimaryBtn}" Click="ToggleBtn_Click" Padding="22,10"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="安全认证" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="ManageBtn" Content="认证方式管理" Style="{StaticResource CardBtn}"
                            Margin="0,0,8,0" Click="ManageBtn_Click"/>
                    <Button x:Name="LockBtn" Content="立即锁定" Style="{StaticResource CardBtn}"
                            Click="LockBtn_Click"/>
                </StackPanel>
                <TextBlock x:Name="AuthStatusText" FontSize="11" Foreground="#7d73a8"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="启动与托盘" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <WrapPanel Orientation="Horizontal">
                    <CheckBox x:Name="AutoLaunchBox" Content="开机自动启动软件"
                              Style="{StaticResource Check}" Checked="AutoLaunch_Changed" Unchecked="AutoLaunch_Changed"/>
                    <CheckBox x:Name="AutoStartServerBox" Content="启动后自动开启服务"
                              Style="{StaticResource Check}" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <CheckBox x:Name="LaunchSilentBox" Content="开机自启时静默到后台"
                              Style="{StaticResource Check}" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <CheckBox x:Name="HideTrayBox" Content="隐藏系统托盘图标"
                              Style="{StaticResource Check}" Checked="TrayOption_Changed" Unchecked="TrayOption_Changed"/>
                    <CheckBox x:Name="MinimizeTrayBox" Content="关闭时最小化到托盘"
                              Style="{StaticResource Check}" Checked="Option_Changed" Unchecked="Option_Changed"/>
                </WrapPanel>
                <TextBlock FontSize="11" Foreground="#7d73a8" TextWrapping="Wrap" Margin="0,6,0,0">
                    「开机自动启动软件」随 Windows 登录启动本程序（写入当前用户的启动项，无需管理员权限）；配合「启动后自动开启服务」即可开机即待命。
                    隐藏托盘图标后可用 Ctrl+Alt+Y 随时唤出主窗口，此时关闭窗口将直接退出程序。
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="隐私与授权" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="PrivacyPolicyBtn" Content="查看隐私政策" Style="{StaticResource CardBtn}"
                            Margin="0,0,8,0" Click="PrivacyPolicyBtn_Click"/>
                    <Button x:Name="PrivacyRevokeBtn" Content="撤回同意" Style="{StaticResource CardBtn}"
                            Click="PrivacyRevokeBtn_Click"/>
                </StackPanel>
                <TextBlock x:Name="PrivacyStatusText" FontSize="11" Foreground="#7d73a8"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="运行日志" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" Background="#160d2e" Foreground="#bdb4e8"
                         FontFamily="Consolas,Monospace" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="7" FontSize="11" Foreground="#7d73a8" TextWrapping="Wrap" Margin="0,4,0,0">
            手表端通过 WiFi 直连「本机 IP:端口」发送指令；连接后先发送 {"cmd":"auth","token":"配对码"} 完成鉴权。关机/重启需二次确认。
            开机请使用手表的 WoL 功能（需 BIOS 开启网络唤醒，并在手表设置中填写上方 MAC）。
        </TextBlock>
    </Grid>
</Window>
