<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 目标框架：带 Windows SDK 版本以支持 WinRT 蓝牙。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YiTongYao</AssemblyName>
    <RootNamespace>YiTongYao.Windows</RootNamespace>
    <ApplicationIcon>Assets\vty_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 抑制 WinForms DPI 提示（WFAC010）。 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyTitle>易通遥 远程控制</AssemblyTitle>
    <Product>易通遥</Product>
    <Version>1.9.1.5</Version>
    <AssemblyVersion>1.9.1.5</AssemblyVersion>
    <FileVersion>1.9.1.5</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 移除 System.Windows.Forms 隐式导入。 -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\vty_icon.ico" />
    <Content Include="Assets\vty_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\vty_icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 隐私政策与 GPL-3.0 许可证全文随程序发布 -->
    <Content Include="..\..\PRIVACY.md" Link="PRIVACY.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
