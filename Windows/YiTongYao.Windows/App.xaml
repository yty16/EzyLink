<Application x:Class="YiTongYao.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- 主题调色板：由 ThemeManager 运行时覆盖，默认深色 -->
        <SolidColorBrush x:Key="AppBg" Color="#1b1136"/>
        <SolidColorBrush x:Key="AppSurface" Color="#251846"/>
        <SolidColorBrush x:Key="AppSurfaceAlt" Color="#2a2350"/>
        <SolidColorBrush x:Key="AppControlBg" Color="#3a2a6e"/>
        <SolidColorBrush x:Key="AppBorder" Color="#3a2a6e"/>
        <SolidColorBrush x:Key="AppFg" Color="#ECEAFF"/>
        <SolidColorBrush x:Key="AppFgMuted" Color="#9C93C9"/>
        <SolidColorBrush x:Key="AppFgDim" Color="#7d73a8"/>
        <SolidColorBrush x:Key="AppAccent" Color="#36E2E8"/>
        <SolidColorBrush x:Key="AppAccent2" Color="#965CE9"/>
        <SolidColorBrush x:Key="AppAccentFg" Color="#11102A"/>
        <SolidColorBrush x:Key="AppDanger" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="AppDangerBg" Color="#6e2a3a"/>
        <SolidColorBrush x:Key="AppLogBg" Color="#160d2e"/>
        <SolidColorBrush x:Key="AppLogFg" Color="#bdb4e8"/>
        <!-- 品牌渐变，由 ThemeManager 重建 -->
        <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#36E2E8" Offset="0"/>
            <GradientStop Color="#965CE9" Offset="1"/>
        </LinearGradientBrush>
    </Application.Resources>
</Application>
