<Window x:Class="YiTongYao.Windows.RecoveryCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="易通遥 · 一次性恢复码" Height="430" Width="560"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource AppFg}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="Assets\vty_icon.ico">
    <Window.Resources>
        <Style x:Key="RcBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AppControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppFgDim}"/>
                    <Setter Property="Cursor" Value="None"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RcPrimaryBtn" TargetType="Button" BasedOn="{StaticResource RcBtn}">
            <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentFg}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="Assets\vty_icon.png" Width="28" Height="28" Margin="0,0,10,0"
                   VerticalAlignment="Center"/>
            <TextBlock Text="保存你的恢复码" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" LineHeight="21" FontSize="13">
            这是本机专用的恢复码。忘记密码、丢失 U 盘或无法完成验证时，可在任意验证框输入它解锁，也可用作保密问题的答案。
        </TextBlock>

        <Border Grid.Row="2" Background="{DynamicResource AppLogBg}" BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
            <TextBox x:Name="CodeBox" IsReadOnly="True" TextWrapping="Wrap"
                     FontFamily="Consolas" FontSize="19" FontWeight="Bold" TextAlignment="Center"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource AppAccent}" Cursor="IBeam"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="CopyBtn" Content="复制" Style="{StaticResource RcBtn}" Click="CopyBtn_Click"/>
            <TextBlock x:Name="CopyHint" Text="已复制到剪贴板" FontSize="11" VerticalAlignment="Center"
                       Margin="10,0,0,0" Foreground="{DynamicResource AppFgMuted}" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock TextWrapping="Wrap" LineHeight="20" FontSize="12" Foreground="{DynamicResource AppFgMuted}">
                此码仅显示这一次，请立即抄写或存入密码管理器。程序只保存它的加盐哈希，不会保存明文，之后无法再次查看。
            </TextBlock>
            <TextBlock TextWrapping="Wrap" LineHeight="20" FontSize="12" Foreground="{DynamicResource AppFgMuted}"
                       Margin="0,6,0,0">
                每台机器的恢复码都不同，源码与安装包内不含任何固定口令。可在「认证方式」窗口重新生成，重新生成后旧码立即失效。
            </TextBlock>
            <CheckBox x:Name="SavedBox" Content="我已抄写并妥善保存" Margin="0,14,0,0"
                      Foreground="{DynamicResource AppFg}" FontSize="13"
                      Checked="SavedBox_Changed" Unchecked="SavedBox_Changed"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SkipBtn" Content="暂不启用" Style="{StaticResource RcBtn}" Click="SkipBtn_Click"/>
            <Button x:Name="DoneBtn" Content="完成" Width="100" Margin="10,0,0,0"
                    Style="{StaticResource RcPrimaryBtn}" Click="DoneBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
