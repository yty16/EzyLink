<Window x:Class="YiTongYao.Windows.AuthMethodsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="认证方式" Height="520" Width="620"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource AppFg}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="Assets\vty_icon.ico">
    <Window.Resources>
        <!-- 禁用态显式上色，避免 WPF 默认浅底淡字在深色主题下看不清 -->
        <Style x:Key="AuthBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AppControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppFgDim}"/>
                    <Setter Property="Cursor" Value="None"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AuthDangerBtn" TargetType="Button" BasedOn="{StaticResource AuthBtn}">
            <Setter Property="Background" Value="{DynamicResource AppDangerBg}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="已登记的认证方式" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

        <Border Grid.Row="1" Background="{DynamicResource AppLogBg}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="MethodList" Grid.Row="0" Background="Transparent" Foreground="{DynamicResource AppFg}"
                         BorderThickness="0" SelectionChanged="MethodList_SelectionChanged"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="AddPwdBtn" Content="添加密码" Style="{StaticResource AuthBtn}" Click="AddPwdBtn_Click"/>
                    <Button x:Name="AddSystemBtn" Content="添加系统解锁" Style="{StaticResource AuthBtn}" Click="AddSystemBtn_Click"/>
                    <Button x:Name="AddUsbBtn" Content="登记U盘" Style="{StaticResource AuthBtn}" Click="AddUsbBtn_Click"/>
                    <Button x:Name="EditBtn" Content="修改" Style="{StaticResource AuthBtn}" Click="EditBtn_Click"/>
                    <Button x:Name="RemoveBtn" Content="删除" Style="{StaticResource AuthDangerBtn}" Click="RemoveBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="10" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock x:Name="OpsTitle" Text="保护的操作" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <WrapPanel x:Name="OpsPanel" Orientation="Horizontal"/>
                <TextBlock x:Name="ScopeHint" FontSize="11" Foreground="{DynamicResource AppFgDim}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                <CheckBox x:Name="TwoFactorBox" Content="启用双因子（需两种不同类别的认证方式）"
                          Foreground="{DynamicResource AppFg}" FontSize="12" Margin="0,8,0,0"
                          Checked="TwoFactor_Changed" Unchecked="TwoFactor_Changed"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseBtn" Content="关闭" Width="90" Background="{StaticResource BrandBrush}" Foreground="{DynamicResource AppAccentFg}"
                    FontWeight="Bold" BorderThickness="0" Padding="10,6" Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
