<Window x:Class="YiTongYao.Windows.SetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置密码" Height="380" Width="460"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource AppFg}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="Assets\vty_icon.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Text="设置新密码（至少 4 位）" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

        <PasswordBox x:Name="PwdBox" Grid.Row="1" Background="{DynamicResource AppLogBg}" Foreground="{DynamicResource AppFg}"
                     BorderBrush="{DynamicResource AppBorder}" Padding="8" Margin="0,4,0,4"/>
        <PasswordBox x:Name="ConfirmBox" Grid.Row="2" Background="{DynamicResource AppLogBg}" Foreground="{DynamicResource AppFg}"
                     BorderBrush="{DynamicResource AppBorder}" Padding="8" Margin="0,4,0,4"/>

        <CheckBox x:Name="QuestionCheck" Grid.Row="3" Content="设置保密问题（忘记密码时可用保密问题重置）"
                  Foreground="{DynamicResource AppFg}" FontSize="13" Margin="0,10,0,4"
                  Checked="QuestionCheck_Changed" Unchecked="QuestionCheck_Changed"/>

        <StackPanel x:Name="QuestionPanel" Grid.Row="4" Visibility="Collapsed" Margin="0,4,0,4">
            <TextBox x:Name="QuestionBox" Background="{DynamicResource AppLogBg}" Foreground="{DynamicResource AppFg}"
                     BorderBrush="{DynamicResource AppBorder}" Padding="8" Margin="0,2,0,6"/>
            <PasswordBox x:Name="AnswerBox" Background="{DynamicResource AppLogBg}" Foreground="{DynamicResource AppFg}"
                         BorderBrush="{DynamicResource AppBorder}" Padding="8" Margin="0,2,0,2"/>
        </StackPanel>

        <TextBlock Grid.Row="5" FontSize="11" Foreground="{DynamicResource AppFgDim}" TextWrapping="Wrap" Margin="0,6,0,0">
            请牢记密码，系统仅保存密码的哈希、不会存储明文；若遗忘且未设置保密问题，将无法重置。
        </TextBlock>

        <TextBlock x:Name="HintText" Grid.Row="6" FontSize="12" Foreground="{DynamicResource AppDanger}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,6,0,0"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkBtn" Content="确定" Width="90" Background="{StaticResource BrandBrush}" Foreground="{DynamicResource AppAccentFg}"
                    FontWeight="Bold" BorderThickness="0" Padding="10,6" Margin="0,0,8,0" Click="OkBtn_Click"/>
            <Button x:Name="CancelBtn" Content="取消" Width="90" Background="{DynamicResource AppControlBg}" Foreground="{DynamicResource AppFg}"
                    BorderThickness="0" Padding="10,6" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
