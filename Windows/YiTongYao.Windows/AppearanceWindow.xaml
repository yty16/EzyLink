<Window x:Class="YiTongYao.Windows.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外观设置" Height="430" Width="460" MinHeight="380" MinWidth="420"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource AppFg}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        UseLayoutRounding="True" Icon="Assets\vty_icon.ico">
    <Window.Resources>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="选择此强调色"/>
        </Style>
        <Style x:Key="ASection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppFgMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>
        <Style x:Key="ABtn" TargetType="Button" BasedOn="{StaticResource AccentBtn}">
            <Setter Property="Background" Value="{DynamicResource AppControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="外观设置" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource AppFg}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" FontSize="11" Foreground="{DynamicResource AppFgMuted}"
                   Margin="0,30,0,0" Text="主题颜色在所有窗口实时生效；选择「跟随系统」时可随 Windows 深浅色自动切换。"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
            <StackPanel>
                <TextBlock Text="主题模式" Style="{StaticResource ASection}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbSystem" Content="跟随系统" GroupName="Mode"
                                 Foreground="{DynamicResource AppFg}" Margin="0,0,18,0"
                                 Checked="Mode_Changed" VerticalContentAlignment="Center"/>
                    <RadioButton x:Name="RbLight" Content="浅色" GroupName="Mode"
                                 Foreground="{DynamicResource AppFg}" Margin="0,0,18,0"
                                 Checked="Mode_Changed" VerticalContentAlignment="Center"/>
                    <RadioButton x:Name="RbDark" Content="深色" GroupName="Mode"
                                 Foreground="{DynamicResource AppFg}"
                                 Checked="Mode_Changed" VerticalContentAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="强调色" Style="{StaticResource ASection}"/>
                <WrapPanel x:Name="SwatchPanel" Orientation="Horizontal"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource AppFgDim}" Margin="0,8,0,0"
                           Text="点击色块预览；「默认」恢复为深浅色各自的标准强调色。"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource ABtn}"
                    Padding="16,8" Margin="0,0,10,0" Click="CancelBtn_Click"/>
            <Button x:Name="SaveBtn" Content="保存" Style="{StaticResource AccentBtn}"
                    Padding="16,8" Click="SaveBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
