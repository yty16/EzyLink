<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:padding="20dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="@string/dl_pc_title" android:textSize="20sp"
                android:textStyle="bold" android:textColor="@color/fg" android:layout_marginBottom="8dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/dl_pc_desc" android:textSize="13sp"
                android:textColor="@color/fg_muted" android:lineSpacingExtra="2dp"
                android:layout_marginBottom="14dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/dl_pc_tip" android:textSize="12sp"
                android:textColor="@color/fg_dim" android:layout_marginBottom="10dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/dl_pc_pan_code_label" android:textSize="13sp"
                android:textStyle="bold" android:textColor="@color/accent"
                android:layout_marginBottom="14dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/dlPcGithub" android:text="@string/dl_pc_github_btn"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:textSize="15sp"
                android:textColor="@color/accent_fg" android:background="@color/accent"
                android:layout_marginBottom="10dp"/>
            <Button android:id="@+id/dlPcPan" android:text="@string/dl_pc_pan_btn"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:textSize="15sp"
                android:textColor="@color/accent_fg" android:background="@color/accent2"
                android:layout_marginBottom="6dp"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:orientation="vertical" android:padding="12dp"
        android:background="@color/surface_alt"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/dlPcDismiss" android:text="@string/dl_pc_dismiss"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/fg" android:background="@color/surface"/>
    </LinearLayout>
</LinearLayout>
