<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="@dimen/scr_pad">
        <TextView android:text="@string/app_name" android:textSize="24sp"
            android:textStyle="bold" android:textColor="#1b1136" android:layout_marginBottom="0dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="@string/app_name_en" android:textSize="12sp"
            android:textColor="#8a86a8" android:layout_marginBottom="4dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/status" android:text="@string/status_ready"
            android:textSize="15sp" android:textColor="#0a8a8f" android:layout_marginBottom="4dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/connState" android:text="@string/conn_idle"
            android:textSize="13sp" android:textColor="#777777" android:layout_marginBottom="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnScan" style="@style/Btn" android:text="@string/scan_connect"/>
            <Button android:id="@+id/btnImmersion" style="@style/Btn" android:text="@string/immersion_title"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnDevices" style="@style/Btn" android:text="@string/devices_title"/>
            <Button android:id="@+id/btnAbout" style="@style/Btn" android:text="@string/btn_about"/>
        </LinearLayout>
        <TextView android:id="@+id/scanHint" android:text="@string/scan_hint"
            android:textSize="12sp" android:textColor="#5f6b7a" android:layout_marginBottom="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/immersionHintMain" android:text="@string/immersion_help"
            android:textSize="12sp" android:textColor="#5f6b7a" android:layout_marginBottom="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnStart" style="@style/Btn" android:text="开始放映"/>
            <Button android:id="@+id/btnNext" style="@style/Btn" android:text="下一张"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnPrev" style="@style/Btn" android:text="上一张"/>
            <Button android:id="@+id/btnExit" style="@style/Btn" android:text="退出放映"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnBlack" style="@style/Btn" android:text="黑屏"/>
            <Button android:id="@+id/btnWhite" style="@style/Btn" android:text="白屏"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnLock" style="@style/Btn" android:text="锁屏"/>
            <Button android:id="@+id/btnSleep" style="@style/Btn" android:text="睡眠"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnWol" style="@style/Btn" android:text="开机(WoL)"/>
            <Button android:id="@+id/btnSettings" style="@style/Btn" android:text="设置"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnShutdown" style="@style/BtnDanger" android:text="关机"/>
            <Button android:id="@+id/btnRestart" style="@style/BtnDanger" android:text="重启"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
