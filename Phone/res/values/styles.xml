<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 使用框架标准 Material 主题。 -->
    <!-- 主题跟随系统深浅色。 -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
    </style>
    <style name="Btn" parent="@android:style/Widget.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">@dimen/btn_minh</item>
        <item name="android:textSize">@dimen/btn_text</item>
        <item name="android:layout_margin">4dp</item>
    </style>
    <style name="BtnDanger" parent="@style/Btn">
        <item name="android:textColor">@color/danger</item>
    </style>
</resources>
