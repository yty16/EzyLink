<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:padding="@dimen/scr_pad"
            android:gravity="center_horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="@string/agree_title" android:textSize="12sp"
                android:textStyle="bold" android:textColor="#36E2E8" android:layout_marginBottom="3dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/agree_intro" android:textSize="9sp"
                android:textColor="#9E9E9E" android:layout_marginBottom="6dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/disclaimer_title" android:textSize="10sp"
                android:textStyle="bold" android:textColor="#ECEAFF" android:layout_marginBottom="2dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/disclaimer_text" android:textSize="9sp"
                android:textColor="#C9C2EE" android:layout_marginBottom="6dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/terms_title" android:textSize="10sp"
                android:textStyle="bold" android:textColor="#ECEAFF" android:layout_marginBottom="2dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/terms_text" android:textSize="9sp"
                android:textColor="#C9C2EE" android:layout_marginBottom="4dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="@string/agree_note" android:textSize="8sp"
                android:textColor="#6E6E88" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:orientation="vertical" android:padding="6dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <CheckBox android:id="@+id/agreeCheck" android:text="@string/agree_check"
            android:textSize="9sp" android:textColor="#ECEAFF"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp">
            <Button android:id="@+id/agreeDecline" android:text="@string/agree_decline"
                android:textSize="9sp" android:layout_weight="1" android:layout_marginEnd="4dp"
                android:layout_width="0dp" android:layout_height="wrap_content" style="@style/BtnDanger"/>
            <Button android:id="@+id/agreeAccept" android:text="@string/agree_accept"
                android:textSize="9sp" android:enabled="false" android:layout_weight="1"
                android:layout_marginStart="4dp" android:layout_width="0dp" android:layout_height="wrap_content"
                android:textColor="#11102A" android:background="#36E2E8"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
